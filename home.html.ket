---
params: [context: {String: Any}]
---
<%# The theme's settings: an `Any` until a type pattern narrows it. %>
<% let settings = match context["settings"].or({}) do
  values: {String: Any} => values
  _ => {}
end %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= context["title"].or("") %> | <%= context["siteTitle"].or("kex") %> <%= settings["brandSub"].or("docs") %></title>
    <meta name="description" content="<%= context["description"].or("") %>">
    <% let siteUrl = "${settings["siteUrl"].or("")}" %>
    <% let base = siteUrl.endsWith?("/") then siteUrl.take(siteUrl.count - 1) else siteUrl %>
    <% let image = "${settings["socialImage"].or("")}" %>
    <% let imageUrl = image.startsWith?("http") then image else base + image %>
    <% let description = "${context["description"].or("")}" %>
    <% if base != "" %>
    <link rel="canonical" href="<%= base %><%= context["path"].or("/") %>">
    <meta property="og:url" content="<%= base %><%= context["path"].or("/") %>">
    <% end %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= context["siteTitle"].or("kex") %> <%= settings["brandSub"].or("docs") %>">
    <meta property="og:title" content="<%= context["title"].or("") %>">
    <meta name="twitter:title" content="<%= context["title"].or("") %>">
    <% if description != "" %>
    <meta property="og:description" content="<%= description %>">
    <meta name="twitter:description" content="<%= description %>">
    <% end %>
    <% if image != "" && (base != "" || image.startsWith?("http")) %>
    <meta property="og:image" content="<%= imageUrl %>">
    <meta name="twitter:image" content="<%= imageUrl %>">
    <meta name="twitter:card" content="summary_large_image">
    <% else %>
    <meta name="twitter:card" content="summary">
    <% end %>
    <meta name="theme-color" content="#fcf5e2">
    <%== context["favicon"].or("") %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Plus+Jakarta+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style><%== context["css"].or("") %></style>
    <script src="<%= context["assetsUrl"].or("/_theme/") %>search.js" defer></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/"><%== context["logo"].or("") %><%= context["siteTitle"].or("kex") %></a>
        <span class="brand-sub"><%= settings["brandSub"].or("docs") %></span>
        <nav class="top-nav" aria-label="Collections"><marqraft-content source="navigation" scope="collections"></marqraft-content></nav>
        <span class="spacer"></span>
        <button class="search-trigger" id="search" type="button" aria-label="Search documentation" data-index="<%= context["searchIndex"].or("") %>"><span>Search</span><kbd>/</kbd></button>
        <% if context["version"].or("") != "" %><span class="pkg-badge"><%= context["collectionTitle"].or("") %> <marqraft-content source="versions"></marqraft-content></span><% end %>
        <nav class="top-links" aria-label="Links"><marqraft-content source="menu" menu="header"></marqraft-content></nav>
      </div>
    </header>
    <div class="wrap layout home">
      <main class="content">
        <article class="prose landing">
          <marqraft-content source="title"></marqraft-content>
          <p class="lede"><marqraft-content source="description"></marqraft-content></p>
          <marqraft-content source="body"></marqraft-content>
        </article>
      </main>
    </div>
    <footer class="foot">
      <div class="wrap">Built with Marqraft · <a href="<%= settings["homeUrl"].or("https://kex.run/docs") %>"><%= settings["homeLabel"].or("kex.run") %></a><nav class="foot-links" aria-label="More"><marqraft-content source="menu" menu="footer"></marqraft-content></nav></div>
    </footer>
  </body>
</html>
