---
params: [context: {String: Any}]
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= context["title"].or("") %> | <%= context["siteTitle"].or("kex") %> <%= context["settings"].try["brandSub"].or("docs") %></title>
    <meta name="description" content="<%= context["description"].or("") %>">
    <%== context["favicon"].or("") %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Plus+Jakarta+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style><%== context["css"].or("") %></style>
    <script src="<%= context["assetsUrl"].or("/_theme/") %>search.js" defer></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/"><%== context["logo"].or("") %><%= context["siteTitle"].or("kex") %></a>
        <span class="brand-sub"><%= context["settings"].try["brandSub"].or("docs") %></span>
        <nav class="top-nav" aria-label="Collections"><marqraft-content source="navigation" scope="collections"></marqraft-content></nav>
        <span class="spacer"></span>
        <button class="search-trigger" id="search" type="button" aria-label="Search documentation" data-index="<%= context["searchIndex"].or("") %>"><span>Search</span><kbd>/</kbd></button>
        <% if context["version"].or("") != "" %><span class="pkg-badge"><%= context["collectionTitle"].or("") %> <marqraft-content source="versions"></marqraft-content></span><% end %>
        <nav class="top-links" aria-label="Links"><marqraft-content source="menu" menu="header"></marqraft-content></nav>
      </div>
    </header>
    <div class="wrap layout home">
      <main class="content">
        <article class="prose landing">
          <marqraft-content source="title"></marqraft-content>
          <p class="lede"><marqraft-content source="description"></marqraft-content></p>
          <marqraft-content source="body"></marqraft-content>
        </article>
      </main>
    </div>
    <footer class="foot">
      <div class="wrap">Built with Marqraft · <a href="<%= context["settings"].try["homeUrl"].or("https://kex.run/docs") %>"><%= context["settings"].try["homeLabel"].or("kex.run") %></a></div>
    </footer>
  </body>
</html>
