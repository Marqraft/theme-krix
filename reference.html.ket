---
params: [context: {String: Any}]
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= context["title"].or("") %> | <%= context["collectionTitle"].or("") %> <%= context["page"].try["version"].or(context["settings"].try["version"].or("")) %> | kex docs</title>
    <meta name="description" content="<%= context["description"].or("") %>">
    <%== context["favicon"].or("") %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Plus+Jakarta+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style><%== context["css"].or("") %></style>
    <script src="<%= context["assetsUrl"].or("/_theme/") %>search.js" defer></script>
  </head>
  <body class="reference">
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/"><%== context["logo"].or("") %><%= context["siteTitle"].or("kex") %></a>
        <span class="brand-sub"><%= context["settings"].try["brandSub"].or("docs") %></span>
        <nav class="top-nav" aria-label="Collections"><marqraft-content source="navigation" scope="collections"></marqraft-content></nav>
        <span class="spacer"></span>
        <button class="search-trigger" id="search" type="button" aria-label="Search documentation" data-index="<%= context["searchIndex"].or("") %>" data-versions="<%= context["settings"].try["versionsIndex"].or("") %>" data-package="<%= context["page"].try["package"].or("") %>" data-version="<%= context["page"].try["version"].or("") %>"><span>Search</span><kbd>/</kbd></button>
        <span class="pkg-badge"<% if context["page"].try["version"].or("") != "" %> id="version-badge" data-versions="<%= context["settings"].try["versionsIndex"].or("") %>" data-package="<%= context["page"].try["package"].or("") %>" data-version="<%= context["page"].try["version"].or("") %>"<% end %>><%= context["collectionTitle"].or("") %> <%= context["page"].try["version"].or(context["settings"].try["version"].or("")) %></span>
        <nav class="top-links" aria-label="Links"><marqraft-content source="menu" menu="header"></marqraft-content></nav>
      </div>
    </header>
    <div class="wrap layout has-toc">
      <aside class="side">
        <nav aria-label="<%= context["collectionTitle"].or("") %>">
          <p class="side-heading"><a href="<%= context["collectionPath"].or("/") %>"><%= context["collectionTitle"].or("") %></a></p>
          <div class="side-tree"><marqraft-content source="navigation" scope="collection"></marqraft-content></div>
        </nav>
      </aside>
      <main class="content">
        <nav class="crumbs"><a href="<%= context["collectionPath"].or("/") %>"><%= context["collectionTitle"].or("") %></a> <span class="sep">/</span> <span><%= context["title"].or("") %></span></nav>
        <article class="prose">
          <marqraft-content source="title"></marqraft-content>
          <marqraft-content source="body"></marqraft-content>
        </article>
      </main>
      <aside class="toc" aria-label="On this page">
        <%== context["page"].try["tocHtml"].or("") %>
      </aside>
    </div>
    <footer class="foot">
      <% let path = "${context["path"].or("/")}" %>
      <% let version = "${context["page"].try["version"].or("")}" %>
      <div class="wrap">Generated from source<% if context["page"].try["source"].or("") != "" %> (<code><%= context["page"].try["source"].or("") %></code>)<% end %> · Built with Marqraft · <% if version != "" %><a href="<%= context["collectionPath"].or("/") %><%= version %>/search.json">search.json</a> · <% end %><% if context["page"].try["source"].or("") != "" %><a href="<%= path.take(path.count - 1) + ".md" %>">Markdown</a> · <% end %><a href="<%= context["settings"].try["homeUrl"].or("https://kex.run/docs") %>"><%= context["settings"].try["homeLabel"].or("kex.run") %></a></div>
    </footer>
  </body>
</html>
